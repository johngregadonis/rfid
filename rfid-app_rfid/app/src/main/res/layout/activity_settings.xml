<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="16dp"
    tools:context="SettingsActivity">

    <!-- Title: Settings -->
    <TextView
        android:id="@+id/settings_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Change Password Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/change_password_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/black"
        android:padding="12dp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settings_title">

        <ImageView
            android:id="@+id/icon_change_password"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/baseline_lock_24"
            app:tint="@android:color/holo_orange_light"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/change_password_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Change Password"
            android:textColor="@android:color/holo_orange_light"
            android:textSize="18sp"
            app:layout_constraintStart_toEndOf="@id/icon_change_password"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/chevron_change_password"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>

        <ImageView
            android:id="@+id/chevron_change_password"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/baseline_chevron_right_24"
            app:tint="@android:color/holo_orange_light"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- About Us Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/about_us_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/black"
        android:padding="12dp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/change_password_button">

        <ImageView
            android:id="@+id/icon_about_us"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/baseline_info_24"
            app:tint="@android:color/holo_orange_light"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/about_us_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="About Us"
            android:textColor="@android:color/holo_orange_light"
            android:textSize="18sp"
            app:layout_constraintStart_toEndOf="@id/icon_about_us"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/chevron_about_us"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>

        <ImageView
            android:id="@+id/chevron_about_us"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/baseline_chevron_right_24"
            app:tint="@android:color/holo_orange_light"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Help Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/help_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/black"
        android:padding="12dp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/about_us_layout">

        <ImageView
            android:id="@+id/icon_help"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/baseline_help_24"
            app:tint="@android:color/holo_orange_light"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/help_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Help"
            android:textColor="@android:color/holo_orange_light"
            android:textSize="18sp"
            app:layout_constraintStart_toEndOf="@id/icon_help"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/chevron_help"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>

        <ImageView
            android:id="@+id/chevron_help"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/baseline_chevron_right_24"
            app:tint="@android:color/holo_orange_light"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- Terms and Privacy Section -->

    <!-- Logout Section -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/terms_privacy_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp"
        android:background="@android:color/black"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/about_us_layout">

        <ImageView
            android:id="@+id/icon_terms_privacy"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/baseline_privacy_tip_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@android:color/holo_orange_light" />

        <TextView
            android:id="@+id/terms_privacy_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="Terms and Privacy"
            android:textColor="@android:color/holo_orange_light"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/chevron_terms_privacy"
            app:layout_constraintStart_toEndOf="@id/icon_terms_privacy"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/chevron_terms_privacy"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/baseline_chevron_right_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@android:color/holo_orange_light" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/logout_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="84dp"
        android:background="@android:color/black"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/help_layout">

        <ImageView
            android:id="@+id/icon_logout"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/baseline_logout_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@android:color/holo_orange_light" />

        <TextView
            android:id="@+id/logout_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="Logout"
            android:textColor="@android:color/holo_orange_light"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/chevron_logout"
            app:layout_constraintStart_toEndOf="@id/icon_logout"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/chevron_logout"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/baseline_chevron_right_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@android:color/holo_orange_light" />
    </androidx.constraintlayout.widget.ConstraintLayout>




    <!-- Log Out All Devices Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btnLogoutAllDevices"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="364dp"
        android:background="@android:color/black"
        android:onClick="logoutAllDevices"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settings_title">

        <ImageView
            android:id="@+id/icon_logout_all"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/baseline_logout_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@android:color/holo_orange_light" />

        <TextView
            android:id="@+id/logout_text_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="Log out all devices"
            android:textColor="@android:color/holo_orange_light"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/chevron_logout_all"
            app:layout_constraintStart_toEndOf="@id/icon_logout_all"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/chevron_logout_all"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/baseline_chevron_right_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@android:color/holo_orange_light" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
