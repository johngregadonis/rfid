<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/dirty_white"
    android:gravity="center_vertical">

    <!-- Title Text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Change Password"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:layout_marginBottom="2dp" />

    <!-- Password Strength Guidelines -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Password must contain at least 4 characters, including an uppercase letter, a lowercase letter, a number, and a special character (@, #, $, etc.) for a strong password."
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:justificationMode="inter_word"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="100dp"
        android:padding="10dp" />

    <!-- Old Password Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter Your Old Password"
        android:textSize="16sp"

        android:textColor="@android:color/black"
        android:layout_marginBottom="5dp" />

    <EditText
        android:id="@+id/oldPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Old Password"
        android:inputType="textPassword"
        android:background="@drawable/edittext_rectangle"
        android:padding="12dp"
        android:textSize="16sp" />

    <!-- New Password Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter Your New Password"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="5dp" />

    <EditText
        android:id="@+id/newPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter New Password"
        android:inputType="textPassword"
        android:background="@drawable/edittext_rectangle"
        android:padding="12dp"
        android:textSize="16sp" />

    <!-- Confirm New Password Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confirm Your New Password"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="5dp" />

    <EditText
        android:id="@+id/confirmNewPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Confirm New Password"
        android:inputType="textPassword"
        android:background="@drawable/edittext_rectangle"
        android:padding="12dp"
        android:textSize="16sp" />

    <!-- Spacer View for Margin -->
    <View
        android:layout_width="match_parent"
        android:layout_height="20dp" />

    <Button
        android:id="@+id/btnChangePassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Change Password"
        android:backgroundTint="@color/orange"
        android:textColor="@android:color/black"
        android:padding="12dp"
        android:textSize="18sp" />



</LinearLayout>
